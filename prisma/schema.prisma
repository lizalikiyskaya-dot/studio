// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MENTOR
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TaskStatus {
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVISION
  ACCEPTED
}

enum SynopsisMode {
  TEXT
  LINK
}

enum MaterialStatus {
  UNREAD
  IN_PROGRESS
  READ
}

enum MaterialCategory {
  BOOK
  HANDOUT
}

enum ArcType {
  POSITIVE
  DISILLUSIONMENT
  FALL
  CORRUPTION
  FLAT
}

enum FreeSectionType {
  TEXT
  TABLE
}

enum PaymentStatus {
  PAID
  PENDING
}

enum WorkPlanStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum SubmissionType {
  CONTEST
  PUBLISHER
}

enum SubmissionStatus {
  WAITING
  ACCEPTED
  REJECTED
}

enum WorldCategory {
  LOCATIONS
  FACTIONS
  LORE
  TECHNOLOGY
  MAGIC
  HISTORY
  CREATURES
  LANGUAGES
}

enum CharacterSource {
  SHARED
  OWN
}

enum SettingSource {
  SHARED
  OWN
}

// Generic comment thread attachable to any record (used in Упражнения).
model Comment {
  id        String   @id @default(cuid())
  model     String
  recordId  String
  field     String?
  author    String
  text      String
  createdAt DateTime @default(now())

  @@index([model, recordId])
}

// Generic mentor-edit suggestion for a single field on any record.
// When a mentor edits a field that the student already filled in,
// the new text is stored here instead of overwriting the field, so
// the student can review and accept it.
model FieldSuggestion {
  id        String   @id @default(cuid())
  model     String
  recordId  String
  field     String
  value     String
  createdAt DateTime @default(now())

  @@unique([model, recordId, field])
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  // Растёт при смене пароля. JWT сессии хранит то же число; более старые
  // токены отклоняются. 0 по умолчанию оставляет уже выданные сессии
  // рабочими до первой смены пароля.
  tokenVersion  Int           @default(0)
  role          UserRole      @default(STUDENT)
  status        UserStatus    @default(PENDING)
  paymentDay    Int?
  // Сумма в рублях. Пусто — в письме суммы нет.
  paymentAmount Int?
  // Письмо утром в день оплаты. Выключает наставник. Без paymentDay письмо не уходит.
  paymentReminders Boolean @default(true)
  paymentStatus PaymentStatus @default(PENDING)
  reviewModeEnabled Boolean   @default(true)
  bookWorkshopUnlocked Boolean @default(true)
  storyWorkshopUnlocked Boolean @default(false)
  lastSeenAt    DateTime?
  lastActivityAt DateTime?
  // Письма об изменениях в кабинете (см. lib/notify.ts). Троттлинг:
  // mentorNotifiedAt — когда наставнику последний раз писали про ЭТОГО
  // ученика, studentNotifiedAt — когда ученику писали про правки наставника.
  emailNotifications Boolean  @default(true)
  mentorNotifiedAt  DateTime?
  studentNotifiedAt DateTime?
  avatarUrl     String?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  books        Book[]
  tasks        Task[]
  materials    Material[]
  drafts       Draft[]
  popArcCharacters  PopArcCharacter[]
  beliefCards       BeliefCard[]
  storyCircleCards  StoryCircleCard[]
  customExercises   CustomExercise[]
  freeSections      FreeSection[]
  notes             Note[]
  cycles            Cycle[]
  stories           Story[]
  workPlans         WorkPlan[]
  submissions       Submission[]
  openCalls         OpenCall[]
  passwordResets    PasswordResetToken[]
  guideAccess       GuideAccess[]
  guideProgress     GuideProgress[]
  paymentReminderLogs PaymentReminderLog[]
}

// Одноразовая ссылка «Забыли пароль?». В базе лежит только SHA-256 от
// токена: утечка дампа не даёт возможности сменить кому-то пароль.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Note {
  id           String    @id @default(cuid())
  studentId    String
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author       String    @default("")
  authorRole   String    @default("STUDENT")
  text         String    @default("")
  anchorQuote  String    @default("")
  anchorLabel  String    @default("")
  anchorUrl    String    @default("")
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
}

model Material {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int              @default(0)
  category  MaterialCategory @default(BOOK)
  title     String           @default("")
  status    MaterialStatus   @default(UNREAD)
  pdfUrl    String?
  pdfName   String?
  epubUrl   String?
  epubName  String?
  fileUrl   String?
  fileName  String?

  @@index([studentId])
}

model Draft {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  title     String   @default("")
  note      String   @default("")
  link      String?
  fileName  String?
  fileData  String?
  createdAt DateTime @default(now())

  @@index([studentId])
}

model PopArcCharacter {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  isExample Boolean  @default(false)

  @@index([studentId])
}

model BeliefCard {
  id           String  @id @default(cuid())
  studentId    String
  student      User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order        Int     @default(0)
  hero         String  @default("")
  startBelief  String  @default("")
  endBelief    String  @default("")
  photoUrl     String?
  isExample    Boolean @default(false)

  @@index([studentId])
}

model StoryCircleCard {
  id        String  @id @default(cuid())
  studentId String
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
  hero      String  @default("")
  data      Json    @default("{}")
  photoUrl  String?
  isExample Boolean @default(false)

  @@index([studentId])
}

model CustomExercise {
  id               String            @id @default(cuid())
  studentId        String
  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order            Int               @default(0)
  task             String            @default("")
  answer           String            @default("")
  answerSuggested  String?
  status           TaskStatus        @default(IN_PROGRESS)
  comments         ExerciseComment[]

  @@index([studentId])
}

model ExerciseComment {
  id         String         @id @default(cuid())
  exerciseId String
  exercise   CustomExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  author     String         @default("")
  text       String         @default("")
  createdAt  DateTime       @default(now())

  @@index([exerciseId])
}

model FreeSection {
  id        String          @id @default(cuid())
  studentId String
  student   User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int             @default(0)
  type      FreeSectionType @default(TEXT)
  title     String          @default("")
  content   String          @default("")
  tableData Json?
  status    TaskStatus      @default(IN_PROGRESS)
  // Карточку завёл сам ученик — ему можно её переименовать и удалить.
  createdByStudent Boolean @default(false)

  @@index([studentId])
}

model Task {
  id           String     @id @default(cuid())
  title        String     @default("")
  workLink     String?
  feedbackLink String?
  notes        String     @default("")
  status       TaskStatus @default(IN_PROGRESS)
  order        Int        @default(0)
  deadline     DateTime?
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([studentId])
}

model Book {
  id        String   @id @default(cuid())
  title     String   @default("")
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  genre            String @default("")
  references       String @default("")
  audience         String @default("")
  partsCount       String @default("")
  timeStructure    String @default("")
  mainCharacters   String @default("")
  dramaticArgument String @default("")
  logline          String @default("")
  concept          String @default("")
  annotation       String @default("")
  coverUrl         String?
  coverUrl2        String?
  coverUrl3        String?
  bannerUrl        String?
  coverPosition    String  @default("50% 50%")
  coverPosition2   String  @default("50% 50%")
  coverPosition3   String  @default("50% 50%")
  bannerPosition   String  @default("50% 50%")

  synopsisMode SynopsisMode @default(TEXT)
  synopsisText String       @default("")
  synopsisLink String       @default("")

  // Название основной таблицы GRAPES. Пустая строка — в кабинете показываем «Сеттинг 1».
  grapesTitle        String @default("")
  grapesGeography    String @default("")
  grapesReligion      String @default("")
  grapesAchievements String @default("")
  grapesPolitics      String @default("")
  grapesEconomy       String @default("")
  grapesSocial        String @default("")
  settingPhotoUrl     String?
  settingChips        String[] @default([])
  settingMapX        Float?
  settingMapY        Float?
  // Доли типов сеттинга 0–100. Пустые — пока считать из старой точки.
  settingManifest    Int?
  settingFilter      Int?
  settingConflict    Int?
  settingMagnet      Int?

  fantasyUnlocked    Boolean @default(false)
  fantasyNotes       String  @default("")
  fantasyGeneral     String  @default("")
  planColumnColors   Json    @default("{}")

  chapters     PlanChapter[]
  characters   Character[]
  acts         Act[]
  worldEntries WorldEntry[]
  extraGrapes  GrapesSetting[]

  @@index([studentId])
}

// Дополнительные таблицы GRAPES под кнопкой «добавить сеттинг».
// Первая таблица по-прежнему живёт в полях Book.
model GrapesSetting {
  id                 String   @id @default(cuid())
  bookId             String
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order              Int      @default(0)
  title              String   @default("")
  grapesGeography    String   @default("")
  grapesReligion     String   @default("")
  grapesAchievements String   @default("")
  grapesPolitics     String   @default("")
  grapesEconomy      String   @default("")
  grapesSocial       String   @default("")
  createdAt          DateTime @default(now())

  @@index([bookId])
}

model PlanChapter {
  id               String  @id @default(cuid())
  bookId           String
  book             Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order             Int     @default(0)
  summary          String  @default("")
  dramaticArgument String  @default("")
  images           String  @default("")
  note             String  @default("")
  plannedChars     Int     @default(0)
  writtenChars     Int     @default(0)
  color            String?
  actBreakAfter    Boolean @default(false)

  @@index([bookId])
}

model Character {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  type      String   @default("MAIN")
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  createdAt DateTime @default(now())

  @@index([bookId])
}

model WorldEntry {
  id        String        @id @default(cuid())
  bookId    String
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category  WorldCategory
  order     Int           @default(0)
  title     String        @default("Новая запись")
  body      String        @default("")
  photoUrl  String?
  createdAt DateTime      @default(now())

  @@index([bookId])
}

model Act {
  id       String       @id @default(cuid())
  bookId   String
  book     Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order    Int          @default(0)
  title    String       @default("")
  subtitle String       @default("")
  content  String       @default("")
  // Пустая строка — статус доски считается по трекеру глав.
  // Иначе: ACCEPTED | IN_PROGRESS | AHEAD.
  status   String       @default("")
  chapters ActChapter[]

  @@index([bookId])
}

model ActChapter {
  id          String           @id @default(cuid())
  actId       String
  act         Act              @relation(fields: [actId], references: [id], onDelete: Cascade)
  order       Int              @default(0)
  title       String           @default("")
  description String           @default("")
  blocks      StorylineBlock[]

  @@index([actId])
}

model StorylineBlock {
  id          String     @id @default(cuid())
  chapterId   String
  chapter     ActChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order       Int        @default(0)
  color       String     @default("pink")
  name        String     @default("")
  description String     @default("")
  // Сколько колонок глав занимает сцена, начиная с chapterId. 1 — как раньше.
  span        Int        @default(1)

  @@index([chapterId])
}

model WorkPlan {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order       Int            @default(0)
  monthStart  String         @default("")
  monthEnd    String         @default("")
  description String         @default("")
  literature  String         @default("")
  note        String         @default("")
  status      WorkPlanStatus @default(PLANNED)
  createdAt   DateTime       @default(now())

  @@index([studentId])
}

// Last time any content in a given section changed, for a given student's
// cabinet, and which role made the change. Used to light "new updates"
// beacons next to sidebar sections for the OTHER party.
model SectionActivity {
  studentId String
  section   String
  at        DateTime @default(now()) @updatedAt
  byRole    String   @default("STUDENT")

  @@id([studentId, section])
}

// Last time a given viewer opened a given section of a given student's
// cabinet. Beacon shows when SectionActivity.at (by the other role) is
// newer than this.
model SectionSeen {
  userId    String
  studentId String
  section   String
  seenAt    DateTime @default(now()) @updatedAt

  @@id([userId, studentId, section])
}

model Submission {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      SubmissionType   @default(CONTEST)
  order     Int              @default(0)
  target    String           @default("")
  work      String           @default("")
  date      String           @default("")
  status    SubmissionStatus @default(WAITING)
  note      String           @default("")
  link      String           @default("")
  createdAt DateTime         @default(now())

  @@index([studentId])
}

model OpenCall {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  target    String   @default("")
  deadline  String   @default("")
  note      String   @default("")
  link      String   @default("")
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId])
}

model Cycle {
  id        String   @id @default(cuid())
  title     String   @default("")
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  genre      String  @default("")
  concept    String  @default("")
  annotation String  @default("")
  coverUrl   String?
  coverPosition  String  @default("50% 50%")
  coverUrl2      String?
  coverPosition2 String  @default("50% 50%")
  coverUrl3      String?
  coverPosition3 String  @default("50% 50%")
  bannerUrl      String?
  bannerPosition String  @default("50% 50%")

  grapesGeography    String @default("")
  grapesReligion     String @default("")
  grapesAchievements String @default("")
  grapesPolitics     String @default("")
  grapesEconomy      String @default("")
  grapesSocial       String @default("")
  settingPhotoUrl    String?
  settingChips       String[] @default([])
  settingMapX        Float?
  settingMapY        Float?
  // Доли типов сеттинга 0–100, как у книги. Пустые — считать из старой точки.
  settingManifest    Int?
  settingFilter      Int?
  settingConflict    Int?
  settingMagnet      Int?

  fantasyUnlocked Boolean @default(false)
  fantasyNotes    String  @default("")
  fantasyGeneral  String  @default("")

  stories      Story[]
  characters   CycleCharacter[]
  worldEntries CycleWorldEntry[]

  @@index([studentId])
}

model Story {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cycleId   String?
  cycle     Cycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  title     String   @default("Новый рассказ")
  createdAt DateTime @default(now())

  concept          String @default("")
  dramaticArgument String @default("")
  genre            String @default("")
  logline          String @default("")

  setupText         String @default("")
  climaxText        String @default("")
  resolutionText    String @default("")
  characterPathText String @default("")

  characterSource CharacterSource @default(SHARED)
  settingSource   SettingSource   @default(SHARED)

  grapesGeography    String   @default("")
  grapesReligion     String   @default("")
  grapesAchievements String   @default("")
  grapesPolitics     String   @default("")
  grapesEconomy      String   @default("")
  grapesSocial       String   @default("")
  settingPhotoUrl    String?
  settingChips       String[] @default([])
  settingMapX        Float?
  settingMapY        Float?
  settingManifest    Int?
  settingFilter      Int?
  settingConflict    Int?
  settingMagnet      Int?
  fantasyNotes       String   @default("")
  fantasyGeneral     String   @default("")

  characters   StoryCharacter[]
  worldEntries StoryWorldEntry[]

  @@index([studentId])
  @@index([cycleId])
}

model CycleCharacter {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  createdAt DateTime @default(now())

  @@index([cycleId])
}

model StoryCharacter {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  type      String   @default("MAIN")
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  createdAt DateTime @default(now())

  @@index([storyId])
}

model CycleWorldEntry {
  id        String        @id @default(cuid())
  cycleId   String
  cycle     Cycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  category  WorldCategory
  order     Int           @default(0)
  title     String        @default("Новая запись")
  body      String        @default("")
  photoUrl  String?
  createdAt DateTime      @default(now())

  @@index([cycleId])
}

// Общая библиотека методичек наставника. Одна запись — один файл на всех
// учеников. Видимость и статус чтения живут отдельно (GuideAccess,
// GuideProgress). Пока строки доступа нет, методичка скрыта.
model Guide {
  id           String   @id @default(cuid())
  title        String   @default("")
  description  String   @default("")
  fileUrl      String?
  fileName     String?
  fileMime     String?
  order        Int      @default(0)
  // Письмо ученику в момент открытия. Выключено, пока наставник сам не отметит.
  notifyOnOpen Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  access       GuideAccess[]
  progress     GuideProgress[]
}

model GuideAccess {
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  visible   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@id([guideId, studentId])
  @@index([studentId])
}

model GuideProgress {
  guideId   String
  guide     Guide          @relation(fields: [guideId], references: [id], onDelete: Cascade)
  studentId String
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    MaterialStatus @default(UNREAD)
  updatedAt DateTime       @updatedAt

  @@id([guideId, studentId])
  @@index([studentId])
}

model StoryWorldEntry {
  id        String        @id @default(cuid())
  storyId   String
  story     Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  category  WorldCategory
  order     Int           @default(0)
  title     String        @default("Новая запись")
  body      String        @default("")
  photoUrl  String?
  createdAt DateTime      @default(now())

  @@index([storyId])
}

// Журнал писем «сегодня день оплаты». Одна строка на человека и календарный
// день срабатывания. Повторный запуск в тот же день упирается в уникальный ключ.
model PaymentReminderLog {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dueOn     DateTime @db.Date
  sentAt    DateTime @default(now())

  @@unique([studentId, dueOn])
  @@index([dueOn])
}
