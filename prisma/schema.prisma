// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MENTOR
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVISION
  ACCEPTED
}

enum SynopsisMode {
  TEXT
  LINK
}

enum MaterialStatus {
  UNREAD
  IN_PROGRESS
  READ
}

enum MaterialCategory {
  BOOK
  HANDOUT
}

enum ArcType {
  POSITIVE
  DISILLUSIONMENT
  FALL
  CORRUPTION
  FLAT
}

enum FreeSectionType {
  TEXT
  TABLE
}

enum PaymentStatus {
  PAID
  PENDING
}

enum WorkPlanStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum SubmissionType {
  CONTEST
  PUBLISHER
}

enum SubmissionStatus {
  WAITING
  ACCEPTED
  REJECTED
  NOT_SENT
  SENT
}

enum WorldCategory {
  LOCATIONS
  FACTIONS
  LORE
  TECHNOLOGY
  MAGIC
  HISTORY
  CREATURES
  LANGUAGES
}

enum CharacterSource {
  SHARED
  OWN
}

enum SettingSource {
  SHARED
  OWN
}

// Откуда звёзды. Очки пишутся в StarAward и второй раз за тот же источник не даются.
enum StarKind {
  WEEKLY
  MAIN_TASK
  CONTEST
  PUBLISHER
}

// Generic comment thread attachable to any record (used in Упражнения).
model Comment {
  id        String   @id @default(cuid())
  model     String
  recordId  String
  field     String?
  author    String
  text      String
  createdAt DateTime @default(now())

  @@index([model, recordId])
}

// Generic mentor-edit suggestion for a single field on any record.
// When a mentor edits a field that the student already filled in,
// the new text is stored here instead of overwriting the field, so
// the student can review and accept it.
model FieldSuggestion {
  id        String   @id @default(cuid())
  model     String
  recordId  String
  field     String
  value     String
  createdAt DateTime @default(now())

  @@unique([model, recordId, field])
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  // Растёт при смене пароля. JWT сессии хранит то же число; более старые
  // токены отклоняются. 0 по умолчанию оставляет уже выданные сессии
  // рабочими до первой смены пароля.
  tokenVersion  Int           @default(0)
  role          UserRole      @default(STUDENT)
  status        UserStatus    @default(PENDING)
  paymentDay    Int?
  // Сумма в рублях. Пусто — в письме суммы нет.
  paymentAmount Int?
  // Письмо утром в день оплаты. Выключает наставник. Без paymentDay письмо не уходит.
  paymentReminders Boolean @default(true)
  paymentStatus PaymentStatus @default(PENDING)
  reviewModeEnabled Boolean   @default(true)
  // Вид «Плана книги» у этого ученика: ribbon, tiles или map.
  planView      String        @default("ribbon")
  bookWorkshopUnlocked Boolean @default(true)
  storyWorkshopUnlocked Boolean @default(false)
  lastSeenAt    DateTime?
  lastActivityAt DateTime?
  // Письма об изменениях в кабинете (см. lib/notify.ts). Троттлинг:
  // mentorNotifiedAt — когда наставнику последний раз писали про ЭТОГО
  // ученика, studentNotifiedAt — когда ученику писали про правки наставника.
  emailNotifications Boolean  @default(true)
  // Отдельная отписка от двух рассылок. true: письмо можно слать.
  weeklyEmails Boolean @default(true)
  quoteEmails  Boolean @default(true)
  mentorNotifiedAt  DateTime?
  studentNotifiedAt DateTime?
  // От кого уходят письма. Пустые строки значат «как в окружении сервера».
  // Пароль SMTP сюда не пишется: он остаётся в SMTP_PASSWORD.
  mailFromName  String @default("")
  mailFromEmail String @default("")
  mailReplyTo   String @default("")
  avatarUrl     String?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  books        Book[]
  tasks        Task[]
  materials    Material[]
  drafts       Draft[]
  popArcCharacters  PopArcCharacter[]
  beliefCards       BeliefCard[]
  storyCircleCards  StoryCircleCard[]
  customExercises   CustomExercise[]
  freeSections      FreeSection[]
  notes             Note[]
  cycles            Cycle[]
  stories           Story[]
  workPlans         WorkPlan[]
  submissions       Submission[]
  openCalls         OpenCall[]
  passwordResets    PasswordResetToken[]
  guideAccess       GuideAccess[]
  guideProgress     GuideProgress[]
  paymentReminderLogs PaymentReminderLog[]
  weeklySubmissions WeeklySubmission[]
  starAwards        StarAward[]
  emailLogs           EmailLog[]
  mailDigests         MailDigest[]
}

// Одноразовая ссылка «Забыли пароль?». В базе лежит только SHA-256 от
// токена: утечка дампа не даёт возможности сменить кому-то пароль.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Note {
  id           String    @id @default(cuid())
  studentId    String
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author       String    @default("")
  authorRole   String    @default("STUDENT")
  text         String    @default("")
  anchorQuote  String    @default("")
  anchorLabel  String    @default("")
  anchorUrl    String    @default("")
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
}

model Material {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int              @default(0)
  category  MaterialCategory @default(BOOK)
  title     String           @default("")
  status    MaterialStatus   @default(UNREAD)
  pdfUrl    String?
  pdfName   String?
  epubUrl   String?
  epubName  String?
  fileUrl   String?
  fileName  String?
  // Книга «по желанию». Методички поле не показывают. Старые строки — false.
  optional  Boolean  @default(false)
  // Рекомендуемый месяц книги, например «ноябрь 2026». Пусто, пока наставник не напишет.
  month     String?
  // Короткая заметка к книге («не целиком», «как словарём»). Методички поле не показывают.
  note      String?

  @@index([studentId])
}

model Draft {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  title     String   @default("")
  note      String   @default("")
  link      String?
  fileName  String?
  fileData  String?
  createdAt DateTime @default(now())

  @@index([studentId])
}

model PopArcCharacter {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  isExample Boolean  @default(false)

  @@index([studentId])
}

model BeliefCard {
  id           String  @id @default(cuid())
  studentId    String
  student      User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order        Int     @default(0)
  hero         String  @default("")
  startBelief  String  @default("")
  endBelief    String  @default("")
  photoUrl     String?
  isExample    Boolean @default(false)

  @@index([studentId])
}

model StoryCircleCard {
  id        String  @id @default(cuid())
  studentId String
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
  hero      String  @default("")
  data      Json    @default("{}")
  photoUrl  String?
  isExample Boolean @default(false)

  @@index([studentId])
}

model CustomExercise {
  id               String            @id @default(cuid())
  studentId        String
  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order            Int               @default(0)
  task             String            @default("")
  answer           String            @default("")
  answerSuggested  String?
  status           TaskStatus        @default(IN_PROGRESS)
  comments         ExerciseComment[]

  @@index([studentId])
}

model ExerciseComment {
  id         String         @id @default(cuid())
  exerciseId String
  exercise   CustomExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  author     String         @default("")
  text       String         @default("")
  createdAt  DateTime       @default(now())

  @@index([exerciseId])
}

model FreeSection {
  id        String          @id @default(cuid())
  studentId String
  student   User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int             @default(0)
  type      FreeSectionType @default(TEXT)
  title     String          @default("")
  content   String          @default("")
  tableData Json?
  status    TaskStatus      @default(IN_PROGRESS)
  // Карточку завёл сам ученик — ему можно её переименовать и удалить.
  createdByStudent Boolean @default(false)

  @@index([studentId])
}

model Task {
  id           String     @id @default(cuid())
  title        String     @default("")
  workLink     String?
  feedbackLink String?
  notes        String     @default("")
  status       TaskStatus @default(IN_PROGRESS)
  order        Int        @default(0)
  deadline     DateTime?
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([studentId])
}

model Book {
  id        String   @id @default(cuid())
  title     String   @default("")
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  genre            String @default("")
  references       String @default("")
  audience         String @default("")
  partsCount       String @default("")
  timeStructure    String @default("")
  mainCharacters   String @default("")
  dramaticArgument String @default("")
  logline          String @default("")
  concept          String @default("")
  annotation       String @default("")
  coverUrl         String?
  coverUrl2        String?
  coverUrl3        String?
  bannerUrl        String?
  coverPosition    String  @default("50% 50%")
  coverPosition2   String  @default("50% 50%")
  coverPosition3   String  @default("50% 50%")
  bannerPosition   String  @default("50% 50%")

  synopsisMode SynopsisMode @default(TEXT)
  synopsisText String       @default("")
  synopsisLink String       @default("")

  // Название основной таблицы GRAPES. Пустая строка — в кабинете показываем «Сеттинг 1».
  grapesTitle        String @default("")
  grapesGeography    String @default("")
  grapesReligion      String @default("")
  grapesAchievements String @default("")
  grapesPolitics      String @default("")
  grapesEconomy       String @default("")
  grapesSocial        String @default("")
  settingPhotoUrl     String?
  settingChips        String[] @default([])
  settingMapX        Float?
  settingMapY        Float?
  // Доли типов сеттинга 0–100. Пустые — пока считать из старой точки.
  settingManifest    Int?
  settingFilter      Int?
  settingConflict    Int?
  settingMagnet      Int?

  fantasyUnlocked    Boolean @default(false)
  fantasyNotes       String  @default("")
  fantasyGeneral     String  @default("")
  planColumnColors   Json    @default("{}")
  // true после того, как главы трекера и плана сведены в одну запись.
  // Старые столбцы при этом не очищаются.
  chaptersUnified    Boolean @default(false)

  chapters     PlanChapter[]
  characters   Character[]
  acts         Act[]
  worldEntries WorldEntry[]
  extraGrapes  GrapesSetting[]

  @@index([studentId])
}

// Дополнительные таблицы GRAPES под кнопкой «добавить сеттинг».
// Первая таблица по-прежнему живёт в полях Book.
model GrapesSetting {
  id                 String   @id @default(cuid())
  bookId             String
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order              Int      @default(0)
  title              String   @default("")
  grapesGeography    String   @default("")
  grapesReligion     String   @default("")
  grapesAchievements String   @default("")
  grapesPolitics     String   @default("")
  grapesEconomy      String   @default("")
  grapesSocial       String   @default("")
  createdAt          DateTime @default(now())

  @@index([bookId])
}

model PlanChapter {
  id               String  @id @default(cuid())
  bookId           String
  book             Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order             Int     @default(0)
  // Одно название для трекера и плана.
  title            String  @default("")
  // Текст плана. Сюда копируются старые суть, ядро, примечание и описание главы акта.
  description      String  @default("")
  summary          String  @default("")
  dramaticArgument String  @default("")
  images           String  @default("")
  note             String  @default("")
  plannedChars     Int     @default(0)
  writtenChars     Int     @default(0)
  color            String?
  actBreakAfter    Boolean @default(false)
  actId            String?
  act              Act?    @relation(fields: [actId], references: [id], onDelete: SetNull)
  blocks           StorylineBlock[]

  @@index([bookId])
  @@index([actId])
}

model Character {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  type      String   @default("MAIN")
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  createdAt DateTime @default(now())

  @@index([bookId])
}

model WorldEntry {
  id        String        @id @default(cuid())
  bookId    String
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category  WorldCategory
  order     Int           @default(0)
  title     String        @default("Новая запись")
  body      String        @default("")
  photoUrl   String?
  createdAt  DateTime @default(now())
  // Пустая строка — первая таблица GRAPES. Иначе id GrapesSetting.
  settingKey String   @default("")

  @@index([bookId])
}

model Act {
  id       String       @id @default(cuid())
  bookId   String
  book     Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order    Int          @default(0)
  title    String       @default("")
  subtitle String       @default("")
  content  String       @default("")
  // Старое поле статуса акта. Чип на доске считается по знакам глав
  // (не начата / в работе / почти / готова) и это поле не показывает.
  status   String       @default("")
  chapters ActChapter[]
  planChapters PlanChapter[]

  @@index([bookId])
}

model ActChapter {
  id          String           @id @default(cuid())
  actId       String
  act         Act              @relation(fields: [actId], references: [id], onDelete: Cascade)
  order       Int              @default(0)
  title       String           @default("")
  description String           @default("")
  blocks      StorylineBlock[]

  @@index([actId])
}

model StorylineBlock {
  id            String       @id @default(cuid())
  // Старая привязка к главе акта. После сведения глав остаётся пустой, сцена живёт на PlanChapter.
  chapterId     String?
  chapter       ActChapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  planChapterId String?
  planChapter   PlanChapter? @relation(fields: [planChapterId], references: [id], onDelete: Cascade)
  order         Int          @default(0)
  color         String       @default("pink")
  name          String       @default("")
  description   String       @default("")
  // Сколько колонок глав занимает сцена, начиная с главы. 1 — как раньше.
  span          Int          @default(1)

  @@index([chapterId])
  @@index([planChapterId])
}

model WorkPlan {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order       Int            @default(0)
  monthStart  String         @default("")
  monthEnd    String         @default("")
  description String         @default("")
  literature  String         @default("")
  note        String         @default("")
  status      WorkPlanStatus @default(PLANNED)
  createdAt   DateTime       @default(now())

  @@index([studentId])
}

// Last time any content in a given section changed, for a given student's
// cabinet, and which role made the change. Used to light "new updates"
// beacons next to sidebar sections for the OTHER party.
model SectionActivity {
  studentId String
  section   String
  at        DateTime @default(now()) @updatedAt
  byRole    String   @default("STUDENT")

  @@id([studentId, section])
}

// Last time a given viewer opened a given section of a given student's
// cabinet. Beacon shows when SectionActivity.at (by the other role) is
// newer than this.
model SectionSeen {
  userId    String
  studentId String
  section   String
  seenAt    DateTime @default(now()) @updatedAt

  @@id([userId, studentId, section])
}

model Submission {
  id        String           @id @default(cuid())
  studentId String
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      SubmissionType   @default(CONTEST)
  order     Int              @default(0)
  target    String           @default("")
  work      String           @default("")
  date      String           @default("")
  status    SubmissionStatus @default(WAITING)
  note      String           @default("")
  link      String           @default("")
  // Опен-колл, с баннера которого заявка попала в трекер.
  // Пусто у заявок, заведённых вручную. Одна ссылка — один опен-колл.
  openCallId String?          @unique
  openCall   OpenCall?        @relation(fields: [openCallId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([studentId])
}

model OpenCall {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  target    String   @default("")
  deadline  String   @default("")
  note      String   @default("")
  link      String   @default("")
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  submission Submission?

  @@index([studentId])
}

model Cycle {
  id        String   @id @default(cuid())
  title     String   @default("")
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  genre      String  @default("")
  concept    String  @default("")
  annotation String  @default("")
  coverUrl   String?
  coverPosition  String  @default("50% 50%")
  coverUrl2      String?
  coverPosition2 String  @default("50% 50%")
  coverUrl3      String?
  coverPosition3 String  @default("50% 50%")
  bannerUrl      String?
  bannerPosition String  @default("50% 50%")

  grapesGeography    String @default("")
  grapesReligion     String @default("")
  grapesAchievements String @default("")
  grapesPolitics     String @default("")
  grapesEconomy      String @default("")
  grapesSocial       String @default("")
  settingPhotoUrl    String?
  settingChips       String[] @default([])
  settingMapX        Float?
  settingMapY        Float?
  // Доли типов сеттинга 0–100, как у книги. Пустые — считать из старой точки.
  settingManifest    Int?
  settingFilter      Int?
  settingConflict    Int?
  settingMagnet      Int?

  fantasyUnlocked Boolean @default(false)
  fantasyNotes    String  @default("")
  fantasyGeneral  String  @default("")

  stories      Story[]
  characters   CycleCharacter[]
  worldEntries CycleWorldEntry[]

  @@index([studentId])
}

model Story {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cycleId   String?
  cycle     Cycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  title     String   @default("Новый рассказ")
  createdAt DateTime @default(now())

  concept          String @default("")
  dramaticArgument String @default("")
  genre            String @default("")
  logline          String @default("")

  setupText         String @default("")
  climaxText        String @default("")
  resolutionText    String @default("")
  characterPathText String @default("")

  characterSource CharacterSource @default(SHARED)
  settingSource   SettingSource   @default(SHARED)

  grapesGeography    String   @default("")
  grapesReligion     String   @default("")
  grapesAchievements String   @default("")
  grapesPolitics     String   @default("")
  grapesEconomy      String   @default("")
  grapesSocial       String   @default("")
  settingPhotoUrl    String?
  settingChips       String[] @default([])
  settingMapX        Float?
  settingMapY        Float?
  settingManifest    Int?
  settingFilter      Int?
  settingConflict    Int?
  settingMagnet      Int?
  fantasyNotes       String   @default("")
  fantasyGeneral     String   @default("")

  characters   StoryCharacter[]
  worldEntries StoryWorldEntry[]

  @@index([studentId])
  @@index([cycleId])
}

model CycleCharacter {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  createdAt DateTime @default(now())

  @@index([cycleId])
}

model StoryCharacter {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  type      String   @default("MAIN")
  name      String   @default("")
  photoUrl  String?
  data      Json     @default("{}")
  arcType   ArcType?
  createdAt DateTime @default(now())

  @@index([storyId])
}

model CycleWorldEntry {
  id        String        @id @default(cuid())
  cycleId   String
  cycle     Cycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  category  WorldCategory
  order     Int           @default(0)
  title     String        @default("Новая запись")
  body      String        @default("")
  photoUrl  String?
  createdAt DateTime      @default(now())

  @@index([cycleId])
}

// Общая библиотека методичек наставника. Одна запись — один файл на всех
// учеников. Видимость и статус чтения живут отдельно (GuideAccess,
// GuideProgress). Пока строки доступа нет, методичка скрыта.
model Guide {
  id           String   @id @default(cuid())
  title        String   @default("")
  description  String   @default("")
  fileUrl      String?
  fileName     String?
  fileMime     String?
  order        Int      @default(0)
  // Старая галочка. Письмо теперь спрашивают при открытии, поле само ничего не шлёт.
  notifyOnOpen Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  access       GuideAccess[]
  progress     GuideProgress[]
}

model GuideAccess {
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  visible   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@id([guideId, studentId])
  @@index([studentId])
}

model GuideProgress {
  guideId   String
  guide     Guide          @relation(fields: [guideId], references: [id], onDelete: Cascade)
  studentId String
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    MaterialStatus @default(UNREAD)
  updatedAt DateTime       @updatedAt

  @@id([guideId, studentId])
  @@index([studentId])
}

model StoryWorldEntry {
  id        String        @id @default(cuid())
  storyId   String
  story     Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  category  WorldCategory
  order     Int           @default(0)
  title     String        @default("Новая запись")
  body      String        @default("")
  photoUrl  String?
  createdAt DateTime      @default(now())

  @@index([storyId])
}

// Заметка к одной карточке «Библии мира». Не путать с fantasyNotes (на весь мир).
// settingKey — id таблицы GRAPES («primary» или GrapesSetting), чтобы заметки
// разных таблиц не смешивались. У тем-записей пустая строка.
model ThemeNote {
  id         String   @id @default(cuid())
  scope      String
  ownerId    String
  settingKey String   @default("")
  theme      String
  body       String   @default("")
  updatedAt  DateTime @updatedAt

  @@unique([scope, ownerId, settingKey, theme])
  @@index([ownerId])
}

// Журнал писем «сегодня день оплаты». Одна строка на человека и календарный
// день срабатывания. Повторный запуск в тот же день упирается в уникальный ключ.
model PaymentReminderLog {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dueOn     DateTime @db.Date
  sentAt    DateTime @default(now())

  @@unique([studentId, dueOn])
  @@index([dueOn])
}

// Календарь «Задание недели». Строки общие для всех учеников, сид в docs/sql.
// Рассылка по субботам сюда не подключена — отдельная задача.
model WeeklyTask {
  id          String   @id
  publishedOn String
  title       String
  prompt      String
  lengthHint  String
  sortOrder   Int
  submissions WeeklySubmission[]

  @@unique([publishedOn])
}

// Одна сдача ученика на неделю. Повторная правка обновляет текст, не строку.
model WeeklySubmission {
  id           String     @id @default(cuid())
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weeklyTaskId String
  weeklyTask   WeeklyTask @relation(fields: [weeklyTaskId], references: [id], onDelete: Cascade)
  text         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([studentId, weeklyTaskId])
  @@index([studentId])
  @@index([weeklyTaskId])
}

// Цитата дня. Список правит наставник. День выбирает строку по порядку sortOrder.
model DailyQuote {
  id         String   @id @default(cuid())
  text       String
  author     String
  source     String
  translator String   @default("")
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

// Журнал звёзд. Уникальный ключ не даёт начислить дважды за один и тот же источник.
model StarAward {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind      StarKind
  points    Int
  sourceId  String
  // Пусто у обычных начислений. «завершение книги» — разовая доплата до 100.
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([studentId, kind, sourceId])
  @@index([studentId])
}

// Каждая попытка sendMail: и ушедшее письмо, и неудача.
// Получатель может уже не быть в базе — строка остаётся, связь пустая.
model EmailLog {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  type            String
  recipientUserId String?
  recipient       User?    @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientEmail  String
  subject         String
  // sent | failed
  status          String
  error           String?
  // Отрисованное письмо, чтобы наставник мог открыть превью. Пусто у старых строк.
  html            String   @default("")

  @@index([createdAt])
  @@index([type])
  @@index([recipientUserId])
}

// Настройки автоматических писем. Пустая таблица: код берёт defaultBroadcast.
// Пароль SMTP сюда не пишется.
model MailBroadcast {
  key           String   @id
  enabled       Boolean
  timeZone      String   @default("Europe/Moscow")
  weekdays      String   @default("")
  hour          Int?
  minute        Int      @default(0)
  windowMinutes Int      @default(60)
  oncePerDay    Boolean  @default(false)
  audience      String   @default("all")
  studentIds    String   @default("")
  sender        String   @default("profile")
  updatedAt     DateTime @updatedAt
}

// Пачка правок или отметка визита, пока письмо не ушло.
model MailDigest {
  id        String    @id @default(cuid())
  kind      String
  studentId String
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section   String    @default("")
  detail    String    @default("")
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([kind, studentId, sentAt])
}
