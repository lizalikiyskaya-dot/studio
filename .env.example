# Скопируйте в .env и подставьте свои значения. В этом файле секретов нет.

# Строка подключения PostgreSQL. Режим SSL код не переопределяет:
# его задаёт параметр sslmode в этой строке (его разбирает node-postgres).
# Свой сертификат CA, если он нужен, указывается там же: sslrootcert=/путь/к/ca.crt
# Путь к сертификату в репозитории не зашит. Каталог /certs в .gitignore.
DATABASE_URL=

# Необязательно. Теневая база Prisma для миграций.
SHADOW_DATABASE_URL=

# Секрет подписи сессионной cookie (HS256). Длинная случайная строка.
JWT_SECRET=

# Только для `npm run seed:mentor`.
MENTOR_EMAIL=
MENTOR_PASSWORD=
# Необязательно. Если пусто, сид подставит имя по умолчанию.
MENTOR_NAME=

# Почта. Пароль сюда не пишем — только на сервере, в /srv/studio/app/.env.
# Пока ящик lizaandreenko не создан, MAIL_FROM не задаём:
# письмо уйдёт от «Студия художественной прозы» с адресом SMTP_USER.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# Когда ящик появится:
# MAIL_FROM="Андреенко · студия художественной прозы <lizaandreenko@ДОМЕН>"
# и SMTP_USER / SMTP_PASSWORD — уже этого ящика.
# APP_URL=https://studio.lizandwriter.ru
